    "test": "hardhat test",
    "build": "hardhat compile",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "interact": "hardhat run scripts/interact.js --network localhost",
    "dev": "HARDHAT_TELEMETRY_DISABLED=1 CI=1 npm-run-all -p node",
    "local": "scripts/local.sh",
    "all": "scripts/all.sh",
    "whoami": "node scripts/whoami.mjs",
    "read": "node -r dotenv/config -e \"const {JsonRpcProvider,Contract}=require('ethers');(async()=>{const p=new JsonRpcProvider(process.env.BASE_SEPOLIA_RPC_URL,{name:'baseSepolia',chainId:84532});const a=require('./deploy-baseSepolia.json').Counter;const abi=[{inputs:[],name:'count',outputs:[{type:'uint256'}],stateMutability:'view',type:'function'}];const c=new Contract(a,abi,p);console.log('count =',(await c.count({blockTag:'latest'})).toString())})()\"",
    "bump": "node scripts/bump-retry.mjs",
    "deploy:base": "hardhat run scripts/deploy.js --network baseSepolia",
    "verify:sourcify": "scripts/verify-base.sh",
    "read:slot": "node -r dotenv/config -e \"const {JsonRpcProvider}=require('ethers');(async()=>{const p=new JsonRpcProvider(process.env.BASE_SEPOLIA_RPC_URL,{name:'baseSepolia',chainId:84532});const a=require('./deploy-baseSepolia.json').Counter;console.log('slot0 =',await p.send('eth_getStorageAt',[a,'0x0','latest']))})()\"",
    "tx": "node scripts/tx.mjs",
    "redeploy:base": "HARDHAT_TELEMETRY_DISABLED=1 CI=1 hardhat run scripts/deploy.js --network baseSepolia && node -r dotenv/config -e \"const {JsonRpcProvider,Contract}=require('ethers');(async()=>{const p=new JsonRpcProvider(process.env.BASE_SEPOLIA_RPC_URL,{name:'baseSepolia',chainId:84532});const a=require('./deploy-baseSepolia.json').Counter;const abi=[{inputs:[],name:'count',outputs:[{type:'uint256'}],stateMutability:'view',type:'function'}];const c=new Contract(a,abi,p);console.log('count =',(await c.count({blockTag:'latest'})).toString())})()\""
